{
  "name": "agriassist-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:auth-emulator": "vitest run --config vitest.emulator.config.js",
    "test:contract": "vitest run test/contract",
    "seed:admin": "node scripts/seedAdmin.js",
    "db:backup": "node scripts/backupDb.js",
    "db:restore": "node scripts/restoreDb.js",
    "loadtest": "node test/perf/loadtest.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.1.0",
    "helmet": "^8.0.0",
    "node-cron": "^3.0.3",
    "sqlite3": "^5.1.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "autocannon": "^8.0.0",
    "eslint": "^9.21.0",
    "globals": "^15.15.0",
    "msw": "^2.7.3",
    "prettier": "^3.5.2",
    "supertest": "^7.0.0",
    "vitest": "^3.0.7"
  }
}
